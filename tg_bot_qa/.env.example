TELEGRAM_BOT_TOKEN=your_telegram_bot_token
GITHUB_TOKEN=your_github_pat_with_actions_scope
REPO_OWNER=your_github_username_or_org
REPO_NAME=your_repository_name
WORKFLOW_ID=tests.yml
WORKFLOW_REF=main

# Comma-separated Telegram user IDs allowed to use the bot (strongly recommended)
ALLOWED_USER_IDS=123456789

# Seconds to wait between workflow dispatches per chat
DISPATCH_COOLDOWN_SEC=30
